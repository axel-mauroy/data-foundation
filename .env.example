# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# GCP
GCP_PROJECT=dealinka-prod
GCP_REGION=europe-west1
ARTIFACT_REGISTRY=europe-west1-docker.pkg.dev/dealinka-prod/models

# MLflow
MLFLOW_TRACKING_URI=https://mlflow.internal.dealinka.com

# dbt (dev | prod)
DBT_TARGET=dev

# ZenML (dev | production)
ZENML_STACK=dev
